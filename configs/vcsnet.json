{
  "name": "VCSNet",
  "seed": 20260730,
  "model": {
    "enable_vcsm": true,
    "enable_caat": true,
    "enable_mbre": true,
    "row": 2,
    "line": 2,
    "indices": [
      "exgr",
      "ngrdi",
      "rgbvi"
    ],
    "vcsm_hidden_channels": 16,
    "vcsm_sample_drop": 0.2,
    "vcsm_channel_drop": 0.1,
    "vcsm_local_kernels": [
      3,
      7
    ],
    "vcsm_delta_max": 1.5,
    "mbre_residual_max": 0.15,
    "caat_hidden_channels": 24
  },
  "loss": {
    "point_loss_mode": "official_compat",
    "point_loss_coef": 0.0002,
    "eos_coef": 0.5,
    "set_cost_class": 1.0,
    "set_cost_point": 0.05,
    "caat_coef": 0.05,
    "caat_smooth_l1_beta": 1.0,
    "caat_local_scales": [
      1,
      3,
      7
    ],
    "caat_positive_weight": 4.0,
    "caat_global_weight": 0.25
  },
  "training": {
    "batch_size": 8,
    "crops_per_source_image": 4,
    "patch_batch_size": 32,
    "num_workers": 8,
    "epochs": 350,
    "lr": 0.0001,
    "lr_backbone": 1e-05,
    "adam_weight_decay": 0.0,
    "lr_drop": 80,
    "clip_max_norm": 0.1,
    "eval_freq": 10,
    "early_stop_patience": 16,
    "device": "cuda"
  },
  "dataset": {
    "root": "data",
    "train_list": "train.txt",
    "val_list": "val.txt",
    "test_list": "test.txt",
    "background_list": "background.txt"
  },
  "evaluation": {
    "threshold": 0.72,
    "pad_block": 1,
    "point_radius": 12.0,
    "batch_size": 1
  },
  "initialization": {
    "official_checkpoint": "weights/SHTechA.pth",
    "start_epoch": 0
  }
}
